# Kopiere diese Datei nach .env und trage eigene Werte ein. Niemals echte Schlüssel committen.

# Betriebsmodus: dry_run (simulierte Agentenantworten, keine API-Kosten) oder live
AICO_MODE=dry_run

# Nur für den Live-Modus erforderlich (OpenAI-Konto mit Guthaben, verursacht Kosten)
OPENAI_API_KEY=

# Optional: eigenes Owner-Token für das Control-Center (sonst wird beim init eines erzeugt)
# AICO_OWNER_TOKEN=

# Optional: Datenverzeichnis (Standard: ./data/<modus>)
# AICO_DATA_DIR=./data/live

# Optional: alternative Konfigurationsdatei
# AICO_CONFIG=./config/settings.toml
